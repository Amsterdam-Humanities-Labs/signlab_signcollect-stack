# Tell PHP where the install root is, once, for the whole server.
#
# signcollect-lib's sc_root() has five sources for that answer, and this is
# the second: the SC_WEB_ROOT environment variable. It is here because the
# first non-/web install exposed a gap in the fourth - the library derives the
# root from its own location, which works for every consumer that can FIND the
# library, and the vendored shim looks for it at ../lib, ../../lib and
# /web/lib. A file sitting AT the docroot root (mysql_config.php, login_sc.php,
# uniqueLabels.php) is one level too high for the relative candidates and, on a
# host whose root is not /web, the absolute one does not exist either. So those
# files fell through to the compiled default and looked for /web/.env, which on
# a --webroot host is a database configuration error on the login page and
# nowhere else - deployed, serving, and unable to authenticate anyone.
#
# The shim cannot be taught a new candidate here: thirteen repositories carry a
# byte-identical copy of it and tests/path-test.sh checksums them against each
# other, so that fix belongs upstream in signlab_signcollect-lib. Stating the
# root to the server is the answer that needs no copy to change, and it is the
# input the library already documents. With --webroot /web it says /web, which
# is what every path already resolved to.
SetEnv SC_WEB_ROOT @WEBROOT@

# SignCollect demo docroot. AllowOverride All matches production, where the
# apps rely on .htaccess for rewrites.
<Directory @WEBROOT@>
    Options +FollowSymLinks -Indexes
    AllowOverride All
    Require all granted

    # Never serve Python source out of the docroot.
    #
    # There is no Python handler configured, so apache serves a .py as
    # text/x-python - the file, verbatim. /zin/convertToString.py returned 200
    # with its own source on this host, imports and database-config shape
    # included. Production denies it: /zin/convertToString.py, /nmm/findSBid.py
    # and /mocap/db_credentials.example.py are all 403 there, so this is a gap
    # in the demo's config rather than a flaw inherited from production, and
    # the pattern is a blanket one to match what production does.
    #
    # It is a backstop, not the fix. The Python that was in the docroot is
    # being removed from the component repositories, which is the real
    # remedy; this is here because the docroot is assembled by rsync from
    # sixteen repositories that several people commit to, and the next .py
    # somebody adds would otherwise be published as source with nobody
    # noticing. It has happened once already.
    #
    # Scoped to this Directory rather than written as a bare <FilesMatch>
    # like the credential rules below, which apply server-wide. pythonCron is
    # a Python service and lives at /opt/pythonCron, outside any DocumentRoot;
    # a server-wide .py rule would not break it today, because nothing maps a
    # URL there, but a rule that could only ever be wrong outside @WEBROOT@ has no
    # business being evaluated outside @WEBROOT@.
    <FilesMatch "\.py$">
        Require all denied
    </FilesMatch>
</Directory>

# The DB credentials live in the docroot (as in production). Never serve them.
<Files "mysql_config*.php">
    Require all denied
</Files>

# Same for the other credential-bearing configs. On a real install
# signbank_sync/config.php carries a Signbank API key, and hh/db_credentials
# a database password; both are plain PHP files inside the docroot.
#
# db_config.php joined them with the shared config library: hh loads its
# database settings through it. It emits nothing when fetched - it only
# defines - so today it is a 200 with a zero-byte body rather than a leak.
# That is a property of what the file happens to contain, not of what it is
# for, and the next thing added to it decides whether it stays true. It is
# the same class of file as the two beside it and is denied on that basis.
<FilesMatch "^(config|db_config|db_credentials)\.php$">
    Require all denied
</FilesMatch>

# The mocap components add a Python flavour of the same thing. Kept even
# though the blanket .py deny inside <Directory @WEBROOT@> above now covers it:
# that rule is scoped to a directory and this one to a filename, so a copy of
# this file reachable through some other DocumentRoot is still denied.
#
# @WEBROOT@/mocap/db_credentials.py holds the database password for the scripts in
# that directory. It is gitignored upstream, so the demo receives only
# db_credentials.example.py - but a production-shaped host has the real one,
# and Apache serves an unhandled .py as plain text. Globbed like the
# mysql_config rule above, which denies its .example too: nothing outside the
# PHP that includes it needs to read either, and a rule whose effect can be
# seen in a response code is a rule that can be tested.
<Files "db_credentials*.py">
    Require all denied
</Files>

# Never serve dotfiles - .env, .git metadata, editor leftovers.
<DirectoryMatch "^@WEBROOT@/.*/\.(git|svn)">
    Require all denied
</DirectoryMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
# Nor backups, dumps, or committed test output.
<FilesMatch "\.(bak|backup|sql|log|save|swp|orig)$|~$">
    Require all denied
</FilesMatch>
