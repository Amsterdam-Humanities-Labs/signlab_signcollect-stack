# HTTPS vhost for the demo instance. @DOMAIN@ is substituted by provision.sh.
#
# ServerName must match the certificate exactly. Tailscale issues certs only
# for a node's own MagicDNS name, so reaching the site by any other name
# (the bare short name, or the raw IP) falls through to whichever vhost sorts
# first and produces a certificate warning.
<IfModule mod_ssl.c>
<VirtualHost *:443>
	ServerName @DOMAIN@
	DocumentRoot @WEBROOT@

	SSLEngine on
	SSLCertificateFile    /etc/ssl/demo/@DOMAIN@.crt
	SSLCertificateKeyFile /etc/ssl/demo/@DOMAIN@.key

	ErrorLog  ${APACHE_LOG_DIR}/demo-error.log
	CustomLog ${APACHE_LOG_DIR}/demo-access.log combined
</VirtualHost>
</IfModule>

# Plain HTTP redirects to HTTPS rather than serving the app unencrypted.
<VirtualHost *:80>
	ServerName @DOMAIN@
	DocumentRoot @WEBROOT@
	# Let's Encrypt renewals answer over plain HTTP; everything else goes to https.
	Alias /.well-known/acme-challenge/ /var/www/html/.well-known/acme-challenge/
	<Directory /var/www/html/.well-known/acme-challenge>
		Require all granted
	</Directory>
	RedirectMatch permanent ^/(?!\.well-known/acme-challenge/)(.*)$ https://@DOMAIN@/$1
</VirtualHost>
